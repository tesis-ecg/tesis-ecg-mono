DATABASE_URL=postgresql+asyncpg://holter:holter@localhost:5435/holter
FRONTEND_URL=http://localhost:5173
S3_BUCKET_NAME=ecg-batches
S3_ENDPOINT_URL=http://minio:9000
# Host de MinIO/S3 tal como lo ve el navegador (URLs prefirmadas del ECG).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_PRESIGN_EXPIRE_SECONDS=600
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
ENVIRONMENT=development

# Auth0 (ROPG + Management API)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://api.holter.local
AUTH0_MGMT_CLIENT_ID=your-mgmt-client-id
AUTH0_MGMT_CLIENT_SECRET=your-mgmt-client-secret
AUTH0_CONNECTION=Username-Password-Authentication

# Session JWT (our own secret — never commit the real value)
JWT_SECRET=change-me-in-production-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=holter-api
JWT_AUDIENCE=holter-dashboard
# Opcional; si falta se deriva de JWT_SECRET.
# AUTH_RATE_LIMIT_SECRET=another-secret-at-least-32-characters
# Obligatorio en preview/production; protege /health/ready.
# READINESS_TOKEN=another-random-token-at-least-32-characters

# Dashboard / watchdog
DASHBOARD_STALE_HOURS=10
DASHBOARD_LOW_BATTERY_PCT=45
DASHBOARD_WIDGET_LIMIT=6
DASHBOARD_ALERTS_LIMIT=10

# Notificaciones push al paciente (Expo Push Service)
# Apagado por defecto: el sender de desarrollo solo escribe en el log lo que
# habría mandado (`push_skipped`, con el `data` completo). Ponerlo en `true`
# para probar la entrega real contra un emulador o un teléfono con token
# registrado — ver `mobile/README.md`.
EXPO_PUSH_ENABLED=false
# Ventana del debounce del aviso de chaleco mal colocado. Solo absorbe repeticiones
# dentro de un mismo episodio: un `signal_recovered` vuelve a habilitar el aviso.
VEST_STATUS_DEBOUNCE_MINUTES=30
