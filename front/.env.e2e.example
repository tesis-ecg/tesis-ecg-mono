# Variables de los specs de Playwright (front/e2e). Copiar a `.env.e2e.local` (ignorado
# por git) y completar. Nunca commitear valores reales.
#
# Los valores van entre comillas simples: el `user_id` de Auth0 lleva un `|` que un shell
# toma por un pipe si se hace `source` de este archivo. Node y `gh` leen las comillas bien.

# ── Usuario de prueba (local y CI) ──────────────────────────────────────────────────────
# Cuenta DEDICADA a los tests, no una personal: el repo es público y su email puede
# aparecer en artefactos de CI. Se crea una sola vez en Auth0 (tenant de DESARROLLO):
# User Management → Users → Create User, con la conexión Username-Password-Authentication.

# El email con el que se creó el usuario.
E2E_EMAIL=''
# La contraseña con la que se creó (tiene que cumplir la password policy del tenant).
E2E_PASSWORD=''
# El `user_id` de ese usuario: Auth0 → Users → <el usuario> → campo "user_id". Empieza
# con `auth0|`. Es el `--auth0-id` de `seed_e2e_user`, que lo vincula a su fila en la base.
E2E_AUTH0_SUB=''

# ── Auth0 de la API (solo CI) ───────────────────────────────────────────────────────────
# NO completar acá para correr en local: la API que levanta Playwright ya los lee de
# `back/.env`, y una variable definida pero vacía PISA ese valor y rompe el login. Son los
# secretos del repo en GitHub, con los MISMOS valores de `back/.env` del tenant de
# desarrollo (nunca los de producción: ver docs/operations.md).
#
# Dominio del tenant, sin `https://`: Applications → <app del backend> → Settings → Domain.
# AUTH0_DOMAIN=
# Applications → <app del backend> → Settings → Client ID.
# AUTH0_CLIENT_ID=
# Applications → <app del backend> → Settings → Client Secret.
# AUTH0_CLIENT_SECRET=
# Applications → APIs → <la API del backend> → Identifier (p. ej. https://api.holter.local).
# AUTH0_AUDIENCE=

# ── Opcional ────────────────────────────────────────────────────────────────────────────
# Puertos del dev server y de la API que levanta Playwright (default 5173 y 8000). Cambiarlos
# evita reusar un stack que ya esté escuchando ahí (otro worktree, por ejemplo).
# E2E_WEB_PORT=5173
# E2E_API_PORT=8000
